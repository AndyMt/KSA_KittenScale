def ImportFileIntoCollection(collection_name, directory, filename):

    # Set the active collection (selected in the outliner)
    bpy.context.view_layer.active_layer_collection = bpy.context.view_layer.layer_collection.children[collection_name]

    active_collection = bpy.context.view_layer.active_layer_collection.collection
    print(f"c {active_collection} {active_collection.name}")

    print(filename)
    # Import the GLB file
    #    bpy.ops.import_scene.gltf(filepath=directory+"\\"+filename, directory=directory, files=[{"name":filename}], loglevel=20)
    bpy.ops.import_scene.gltf(filepath=directory+"\\"+filename)

    # Get the newly imported objects
    imported_objects = bpy.context.selected_objects

    # Link imported objects to the active collection and rename
    bpy.ops.object.select_all(action='DESELECT')
    objEmpty = 0
    objArmature = 0
    objMesh = 0
    print(f"imported_objects: {imported_objects}")
    for obj in imported_objects:
        print(f"o {obj.name}: {obj.type}")
        #rename object to filename
        if (obj.type == "EMPTY" and obj.name != "CutUpGeometry"):
            obj.name = filename
            objEmpty = obj
        if (obj.type == "MESH"):
            objMesh = obj
        if (obj.type == "ARMATURE"):
            obj.name = GetBaseName(filename)
            obj.data.name = GetBaseName(filename)
            objArmature = obj
        obj.select_set(True)        

    # import didn't create empty parent node?
    if not objEmpty and objMesh:
        objMesh.name = filename
        print(f"empty {objMesh}: {objMesh.type}")
        
    if not objEmpty and objArmature:
        objArmature.name = filename
        print(f"empty {objArmature}: {objArmature.type}")

    if False and not objEmpty and objArmature:
        bpy.ops.object.empty_add()        
        objEmpty = bpy.context.active_object
        print(f"empty {objEmpty}: {objEmpty.type}")
        objEmpty.name = filename
        objEmpty.scale = 0.01, 0.01, 0.01
        objArmature.parent = objEmpty
        
        
    print(f"Imported {len(imported_objects)} objects into '{active_collection.name}'")
    return bpy.data.objects[filename]


