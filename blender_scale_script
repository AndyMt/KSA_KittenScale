def delete_objects_outliner():
    area_type = 'OUTLINER'
    areas  = [area for area in bpy.context.window.screen.areas if area.type == area_type]

    if len(areas) <= 0:
        raise Exception(f"Make sure an Area of type {area_type} is open or visible in your screen!")

    with bpy.context.temp_override(area=areas[0]):
        bpy.ops.outliner.delete(hierarchy=True)
    return

def delete_object_and_hierarchy_old(obj):
    bpy.ops.object.select_all(action='DESELECT')
    bpy.data.objects[obj.name].select_set(True)

    for child in bpy.data.objects[obj.name].children_recursive:
        child.select_set(True)
        
        
    
    bpy.context.view_layer.objects.active = obj
    bpy.app.timers.register(delete_objects_outliner, first_interval=0.1)
    time.sleep(1)
    
    return

def delete_object_and_hierarchy(obj):
    lst = [o for o in bpy.data.objects[obj.name].children_recursive]
    while lst:
        bpy.data.objects.remove(lst.pop())            

    bpy.data.objects.remove(obj)            
    
    return

    
#----------------------------------------------------------------
def DeleteArmature(filename):
    try:
        grp = bpy.data.objects.get(filename)
        if grp:
            delete_object_and_hierarchy(grp)
            
    except Exception as X:
        print(f"{X}")
        return
    return

def DeleteUnused():
    try:
        grp = bpy.data.objects.get("CutUpGeometry")
        if grp:
            print (f"cug [{grp.name}]")
            delete_object_and_hierarchy(grp)
            bpy.data.objects.remove(grp)            

        garbage = bpy.data.collections["glTF_not_exported"]
        if garbage:
            print (f"garbage [{garbage.name}]")
            obs = [o for o in garbage.objects if o.users == 1]
            while obs:
                bpy.data.objects.remove(obs.pop())            

        lst = [o for o in bpy.data.objects if o.name.startswith("Icosphere")]
        while lst:
            bpy.data.objects.remove(lst.pop())            


        arm = [a for a in bpy.data.armatures if a.users == 0]
        while arm:
            bpy.data.armatures.remove(arm.pop())            
    
        msh = [m for m in bpy.data.meshes if m.users == 0]
        while msh:
            bpy.data.meshes.remove(msh.pop())            

        lst = [o for o in bpy.data.materials if o.users == 0]
        while lst:
            bpy.data.materials.remove(lst.pop())            

        msh = [m for m in bpy.data.images if m.users == 0]
        while msh:
            bpy.data.images.remove(msh.pop())            

        lst = [o for o in bpy.data.actions if o.users == 0]
        while lst:
            bpy.data.actions.remove(lst.pop())            

    except Exception as X:
        print(f"{X}")
        return
    return


def select_object_and_hierarchy(obj):
    print (f"obj [{obj.name}]")

    for child in bpy.data.objects[obj.name].children_recursive:
        print (f"  child [{child.name}]")
    
    for c in bpy.data.objects[obj.name].children_recursive:
        c.select_set(True)

    obj.select_set(True)    
    return


