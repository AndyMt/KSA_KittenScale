def ScaleBones(filename):
    print (f"scaling file [{filename}]")

    rig_name = GetBaseName(filename)
    rig_bones = bpy.data.armatures[rig_name].bones
    ScaleBonesBase(rig_bones, filename)
    return

def ScaleBonesBase(rig_bones, filename):
    print (f"scaling [{filename}]")

    arm = bpy.data.objects.get(GetBaseName(filename))
    # if there is no armature without file ext, then it doesn't have an Empty parent
    if not arm:
        arm = bpy.data.objects.get(filename)
        
    bpy.ops.object.select_all(action='DESELECT')
    arm.select_set(True)
    bpy.context.view_layer.objects.active = arm

    print (f"arm [{arm.name}]")
    bpy.ops.object.mode_set(mode="EDIT")
    bone_to_select = "NeckPart2_M"
    for bone in arm.data.edit_bones:
        bone.select = False
        bone.select_head = False
        bone.select_tail = False

    for bone in arm.data.edit_bones:
        if bone.name == str(bone_to_select):
            bone.select = True
            bone.select_head = True
            bone.select_tail = True
            for child in bone.children_recursive:
                child.select = True    
                child.select_head = True
                child.select_tail = True
            if bone.name == str(bone_to_select):
                arm.data.edit_bones.active = bone
                posHead = arm.matrix_world @ bone.head.copy()

    bpy.ops.transform.resize(
        value=(scale_factor, scale_factor, scale_factor),
        center_override=posHead,
        orient_type='GLOBAL',
        orient_matrix_type='GLOBAL',
        constraint_axis=(False, False, False),
        mirror=False,
        proportional_edit_falloff='SMOOTH',
        proportional_size=1,
        release_confirm=True
    )
    return

